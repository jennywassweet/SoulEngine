# Mistral API Configuration (used when llm.provider: mistral in soul/config.yaml)
MISTRAL_API_KEY=your_mistral_api_key_here

# OpenRouter API Configuration (used when llm.provider: openrouter in soul/config.yaml)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# IMPORTANT: Use numeric user IDs (e.g., 123456789), NOT usernames (@username)
# Get your ID from @userinfobot in Telegram
TELEGRAM_ALLOWED_USERS=user_id_1,user_id_2

# Logging
LOG_LEVEL=INFO
